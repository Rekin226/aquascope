          "min": 2.0,
          "max": null
        },
        {
          "name": "decision",
          "label": "What is being decided",
          "type": "choice",
          "default": "design flow",
          "options": [
            "design flow",
            "risk screening",
            "insurance",
            "inundation extent"
          ],
          "required": false,
          "help": null,
          "min": null,
          "max": null
        }
      ],
      "branches": [
        "at_site",
        "short_record",
        "regional"
      ]
    },
    {
      "id": "groundwater_decline",
      "title": "Groundwater decline at a well",
      "problem": "groundwater_decline",
      "description": "Whether a well's level is declining, how fast (m/yr with confidence), groundwater drought status and recharge; regional signal only when no well is within reach.",
      "variable": "groundwater_level",
      "intake": [
        {
          "name": "horizon",
          "label": "Years of recent record to compare with the full record",
          "type": "int",
          "default": 10,
          "options": [],
          "required": false,
          "help": null,
          "min": 1.0,
          "max": null
        },
        {
          "name": "concern",
          "label": "Why it matters",
          "type": "choice",
          "default": "other",
          "options": [
            "supply",
            "subsidence",
            "ecosystem",
            "other"
          ],
          "required": false,
          "help": null,
          "min": null,
          "max": null
        },
        {
          "name": "attribute_cause",
          "label": "Attribute the decline to a cause (pumping, drought, land use)",
          "type": "bool",
          "default": false,
          "options": [],
          "required": false,
          "help": null,
          "min": null,
          "max": null
        }
      ],
      "branches": [
        "well",
        "regional"
      ]
    },
    {
      "id": "irrigation_feasibility",
      "title": "Irrigation feasibility at a point",
      "problem": "irrigation",
      "description": "A crop's seasonal water demand at a point (FAO-56 single Kc on ERA5 reference ET0) in mm, m3 and m3/s, and whether the nearest gauged river can supply it as a run-of-river abstraction; demand only when no gauge is within reach.",
