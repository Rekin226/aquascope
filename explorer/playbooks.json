{
  "playbooks": [
    {
      "id": "drought_status",
      "title": "Drought status at a place",
      "problem": "drought",
      "description": "Whether a place is in drought and how severe it is: SPI and SPEI at several timescales from a rain gauge or the ERA5 cell, the groundwater drought index and its lag at a well within reach, the low-flow context at a gauge.",
      "variable": "precipitation",
      "intake": [
        {
          "name": "timescales",
          "label": "Timescales (months)",
          "type": "list",
          "default": [
            1,
            3,
            12
          ],
          "options": [],
          "required": false,
          "help": "Accumulation periods for SPI and SPEI, in months (1 for the month, 3 for the season, 12 for the year).",
          "min": null,
          "max": null
        },
        {
          "name": "drought_concern",
          "label": "What the drought matters for",
          "type": "choice",
          "default": "other",
          "options": [
            "agriculture",
            "water supply",
            "groundwater",
            "other"
          ],
          "required": false,
          "help": null,
          "min": null,
          "max": null
        },
        {
          "name": "flash_drought",
          "label": "Flash drought (weeks, not months)",
          "type": "bool",
          "default": false,
          "options": [],
          "required": false,
          "help": null,
          "min": null,
          "max": null
        }
      ],
      "branches": [
        "gauge_indices",
        "gauge_indices_marginal",
        "gauge_spi_only",
        "reanalysis"
      ]
    },
    {
      "id": "flood_risk",
      "title": "Flood risk at a site",
      "problem": "flood_risk",
      "description": "Design flow or flood screening at a point, from a long gauge record, a short one, or none.",
      "variable": "discharge",
      "intake": [
        {
          "name": "return_period",
          "label": "Return period (years)",
          "type": "int",
          "default": 100,
          "options": [],
