          "min": null,
          "max": null
        },
        {
          "name": "demand_ml_day",
          "label": "Demand (ML/day)",
          "type": "float",
          "default": null,
          "options": [],
          "required": false,
          "help": "The abstraction wanted, in megalitres a day (1 ML/day is 0.01157 m3/s).",
          "min": null,
          "max": null
        },
        {
          "name": "use",
          "label": "What the water is for",
          "type": "choice",
          "default": "other",
          "options": [
            "municipal",
            "irrigation",
            "industrial",
            "other"
          ],
          "required": false,
          "help": null,
          "min": null,
          "max": null
        },
        {
          "name": "share",
          "label": "Abstraction share of the flow allowed",
          "type": "float",
          "default": 0.1,
          "options": [],
          "required": false,
          "help": "The largest fraction of the day's flow the abstraction may take (a screening rule).",
          "min": null,
          "max": null
        },
        {
          "name": "storage",
          "label": "The scheme has a reservoir or storage",
          "type": "bool",
          "default": false,
          "options": [],
          "required": false,
          "help": null,
          "min": null,
          "max": null
        }
